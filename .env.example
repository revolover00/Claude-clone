# Server-side configuration
# Supabase URL for server-side operations
SUPABASE_URL=
# Supabase Anon Key for server-side operations
SUPABASE_ANON_KEY=
# Supabase Service Role Key for administrative tasks (Keep secret)
SUPABASE_SERVICE_ROLE_KEY=
# Gemini API Key for AI features
GEMINI_API_KEY=
# Origin allowed for CORS
ALLOWED_ORIGIN=
# Allow guest mode for local development (set to false in production)
ALLOW_GUEST=false

# Client-side configuration
# Supabase URL for client-side operations
VITE_SUPABASE_URL=
# Supabase Anon Key for client-side operations
VITE_SUPABASE_ANON_KEY=
# Allow local mode development (set to false in production)
VITE_ALLOW_LOCAL_MODE=false
