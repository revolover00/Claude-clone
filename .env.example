ALLOWED_ORIGIN=
# Guest API access for local testing — default ON outside production
# (set to false to opt out; never honoured when NODE_ENV=production).
ALLOW_GUEST=
# REQUIRED in production — the server refuses to boot without it. Encrypts saved
# provider API keys at rest. Any strong non-empty value works (normalized to a
# 32-byte key); recommended: openssl rand -base64 32   (or: openssl rand -hex 32)
PROVIDER_KEY_ENCRYPTION_SECRET=
# Optional: previous secret kept during key rotation.
PROVIDER_KEY_ENCRYPTION_SECRET_PREV=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
# Required for production OAuth redirects. Use the public app origin (no trailing path).
CONNECTORS_APP_URL=
# Optional exact callback URL; default: {CONNECTORS_APP_URL}/api/connectors/oauth/callback
CONNECTORS_REDIRECT_URI=
# OAuth app credentials are stored only in the server's environment, never in Supabase rows.
CONNECTOR_OAUTH_GITHUB_CLIENT_ID=
CONNECTOR_OAUTH_GITHUB_CLIENT_SECRET=
CONNECTOR_OAUTH_NOTION_CLIENT_ID=
CONNECTOR_OAUTH_NOTION_CLIENT_SECRET=
CONNECTOR_OAUTH_LINEAR_CLIENT_ID=
CONNECTOR_OAUTH_LINEAR_CLIENT_SECRET=
CONNECTOR_OAUTH_GOOGLE_DRIVE_CLIENT_ID=
CONNECTOR_OAUTH_GOOGLE_DRIVE_CLIENT_SECRET=
CONNECTOR_OAUTH_SLACK_CLIENT_ID=
CONNECTOR_OAUTH_SLACK_CLIENT_SECRET=
# Local mock session (skips the login screen) — default ON in development
# (set to false to require a real sign-in).
VITE_ALLOW_LOCAL_MODE=
VITE_BRAND_LOGO_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=